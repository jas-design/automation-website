---
import Logo from './Logo.astro';
---

<header class="site-header" data-header>
  <div class="site-header__inner shell shell--wide">
    <Logo />
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#work">Work</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="header-cta" href="#contact">
      Plan your system
      <span aria-hidden="true">↗</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <span class="sr-only">Open menu</span>
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu-backdrop" data-menu-backdrop hidden></div>
<aside class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile navigation" aria-hidden="true" data-menu>
  <div class="mobile-menu__top">
    <Logo />
    <button class="menu-close" type="button" data-menu-close><span class="sr-only">Close menu</span>×</button>
  </div>
  <p class="utility-label">Automation systems studio</p>
  <nav>
    <a href="#about">About</a>
    <a href="#services">Services</a>
    <a href="#work">Work</a>
    <a href="#contact">Contact</a>
  </nav>
  <a class="button button--primary mobile-menu__cta" href="#contact">Plan your system <span>↗</span></a>
</aside>
