---
import SvgIcon from '../components/SvgIcon.astro';

const valueStatements = [
  { title: 'Save time', copy: 'Reduce repetitive manual work.', icon: 'value-time' },
  { title: 'Connect', copy: 'Connect your tools and data.', icon: 'value-connect' },
  { title: 'Scale', copy: 'Grow operations without adding unnecessary manual work.', icon: 'value-scale' }
] as const;

const services = [
  {
    number: '01',
    category: 'Sales',
    title: 'Lead & Sales Automation',
    description: 'Capture, qualify, route, and follow up with leads automatically. Score inquiries, update your CRM, alert sales, and book the next step.',
    workflow: ['Lead', 'Qualify', 'CRM', 'Follow-up', 'Meeting'],
    cta: 'Explore lead automation',
    icon: 'service-lead-sales',
    featured: true
  },
  {
    number: '02',
    category: 'Operations',
    title: 'Workflow Automation',
    description: 'Remove repetitive work between the tools your team already uses. Automate handoffs across forms, email, spreadsheets, CRMs, calendars, and internal systems.',
    workflow: ['Trigger', 'Process', 'Update', 'Notify'],
    cta: 'Explore workflows',
    icon: 'service-workflow',
    featured: false
  },
  {
    number: '03',
    category: 'Support',
    title: 'Customer Support Automation',
    description: 'Handle repetitive customer requests without losing the human touch. Automate intake, common questions, ticket routing, scheduling, and human escalation.',
    workflow: ['Message', 'Understand', 'Resolve', 'Escalate'],
    cta: 'Explore support automation',
    icon: 'service-support',
    featured: false
  },
  {
    number: '04',
    category: 'AI systems',
    title: 'AI Agents & Integrations',
    description: 'Add intelligence to workflows that need more than fixed rules. AI agents can understand requests, use connected tools, search information, and prepare actions.',
    workflow: ['Understand', 'Decide', 'Use Tools', 'Act'],
    cta: 'Explore AI systems',
    icon: 'service-ai-orchestration',
    featured: true
  }
] as const;

const additionalWorkflows = [
  { label: 'CRM Sync', icon: 'value-connect' },
  { label: 'Reporting Automation', icon: 'value-scale' },
  { label: 'Document Processing', icon: 'workflow-document' },
  { label: 'Appointment Scheduling', icon: 'workflow-calendar' },
  { label: 'Proposal Generation', icon: 'workflow-document' },
  { label: 'Data Enrichment', icon: 'service-ai-orchestration' },
  { label: 'Email Triage', icon: 'workflow-inbox' },
  { label: 'Human Approvals', icon: 'workflow-approval' },
  { label: 'Internal Notifications', icon: 'workflow-notification' },
  { label: 'Customer Intake', icon: 'service-lead-sales' }
] as const;
---

<section class="services grid-surface" id="services" data-header-theme="light">
  <div class="shell">
    <div class="services__layout">
      <header class="services__intro reveal">
        <p class="utility-label">What we automate</p>
        <h2>Less busywork.<br />More momentum.</h2>
        <p class="services__summary">We start with the processes that cost your team the most time, create delays, or let opportunities fall through the cracks.</p>

        <ul class="service-values" aria-label="Automation outcomes">
          {valueStatements.map((value) => (
            <li class="service-value">
              <span class="service-value__icon"><SvgIcon name={value.icon} /></span>
              <span>
                <strong>{value.title}</strong>
                <span>{value.copy}</span>
              </span>
            </li>
          ))}
        </ul>
      </header>

      <div class="service-grid" aria-label="Core automation services">
        {services.map((service, index) => (
          <article class:list={['service-card', 'reveal', { 'service-card--featured': service.featured }]} style={`--delay:${index * 70}ms`}>
            <div class="service-card__topline">
              <span class="service-card__number">{service.number}</span>
              <span class="service-card__category">{service.category}</span>
            </div>

            <SvgIcon name={service.icon} class="service-card__icon" />

            <div class="service-card__copy">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>

            <div class="service-card__workflow">
              <span class="utility-label">Workflow</span>
              <ol aria-label={`${service.title} workflow`}>
                {service.workflow.map((step, stepIndex) => (
                  <li>
                    <span>{step}</span>
                    {stepIndex < service.workflow.length - 1 && <span class="service-card__workflow-arrow" aria-hidden="true">→</span>}
                  </li>
                ))}
              </ol>
            </div>

            <a class="service-card__cta" href="#contact">
              <span>{service.cta}</span>
              <SvgIcon name="arrow-up-right" />
            </a>
          </article>
        ))}
      </div>
    </div>

    <div class="more-workflows reveal">
      <div class="more-workflows__heading">
        <p class="utility-label">More workflows we automate</p>
        <p>10+ common automations</p>
      </div>
      <ul class="more-workflows__grid">
        {additionalWorkflows.map((workflow) => (
          <li>
            <span class="more-workflows__icon"><SvgIcon name={workflow.icon} /></span>
            <span>{workflow.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
