---
import Button from '../components/Button.astro';
---

<section class="showcase grid-surface" id="solutions" data-header-theme="light">
  <div class="showcase__inner shell">
    <div class="showcase__copy reveal">
      <p class="utility-label">One orchestration layer</p>
      <h2>AI that works behind the scenes.</h2>
      <p>Agents handle the judgment. Workflows handle the movement. Your team stays in control of the moments that matter.</p>
      <ul>
        <li><span>01</span> Grounded in your data and operating rules</li>
        <li><span>02</span> Human approval where risk demands it</li>
        <li><span>03</span> Monitored, documented, and easy to improve</li>
      </ul>
      <Button href="#contact" label="Map your workflow" variant="outline" />
    </div>
    <div class="showcase__visual reveal">
      <span class="showcase__orbit showcase__orbit--one" aria-hidden="true"></span>
      <span class="showcase__orbit showcase__orbit--two" aria-hidden="true"></span>
      <img src="/assets/images/orchestration-core.webp" alt="A central orchestration core connecting five business systems" width="1452" height="1089" loading="lazy" />
      <div class="showcase__label showcase__label--top"><span></span>CRM</div>
      <div class="showcase__label showcase__label--right"><span></span>SUPPORT</div>
      <div class="showcase__label showcase__label--bottom"><span></span>OPERATIONS</div>
    </div>
  </div>
</section>
